! *****************************************************************************
MODULE ELMFIRE_GPU ! Module for GPU acceleration of ELMFIRE
! *****************************************************************************

   USE CUDAFOR ! Cuda fortran
   USE ELMFIRE_VARS
   IMPLICIT NONE

   ! SoA host arrays realocated every timestep (CALC_NORMAL_VECTORS_CUDA)
   REAL,    ALLOCATABLE :: NORMVECTORX_h(:), NORMVECTORY_h(:), PHIP_OLD_h(:)
   REAL,    ALLOCATABLE :: PHIP_NBHD_h(:,:) ! Values of PHIP

   ! Device arrays (CALC_NORMAL_VECTORS_CUDA)
   REAL,    DEVICE, ALLOCATABLE :: NORMVECTORX_d(:), NORMVECTORY_d(:), PHIP_OLD_d(:)
   REAL,    DEVICE, ALLOCATABLE :: PHIP_NBHD_d(:,:)

   ! State (CALC_NORMAL_VECTORS_CUDA)
   INTEGER, SAVE :: CALC_NORMAL_N_d = 0 ! Current size of the device arrays for normal vector calculation
   INTEGER :: CUDA_ERR ! Error code for CUDA operations

   ! *****************************************************************************

   ! SoA host arrays reallocated every timestep (RK2_INTEGRATE_CUDA)
   REAL,    ALLOCATABLE :: RK2_PHIP_OLD_h(:), RK2_UX_h(:), RK2_UY_h(:)
   REAL,    ALLOCATABLE :: RK2_DPHIDX_LIMITED_h(:), RK2_DPHIDY_LIMITED_h(:)
   REAL,    ALLOCATABLE :: RK2_PHIP_NOW_h(:), RK2_PHIP_NEW_h(:)
   LOGICAL, ALLOCATABLE :: RK2_WTU_SPREAD_h(:) ! Interface Model flag per node

   ! Device arrays (RK2_INTEGRATE_CUDA)
   REAL,    DEVICE, ALLOCATABLE :: RK2_PHIP_OLD_d(:), RK2_UX_d(:), RK2_UY_d(:)
   REAL,    DEVICE, ALLOCATABLE :: RK2_DPHIDX_LIMITED_d(:), RK2_DPHIDY_LIMITED_d(:)
   REAL,    DEVICE, ALLOCATABLE :: RK2_PHIP_NOW_d(:), RK2_PHIP_NEW_d(:)
   LOGICAL, DEVICE, ALLOCATABLE :: RK2_WTU_SPREAD_d(:)

   ! State (RK2_INTEGRATE_CUDA)
   INTEGER, SAVE :: RK2_N_d = 0 ! Current size of the device arrays for RK2 integration
    
CONTAINS

! *****************************************************************************
! CUDA version of the normal vector calculation, this is the wraper
SUBROUTINE CALC_NORMAL_VECTORS_CUDA(ISTEP, HALFRCELLSIZE)
! *****************************************************************************
   INTEGER, INTENT(IN) :: ISTEP
   REAL, INTENT(IN) :: HALFRCELLSIZE
   INTEGER :: I, N
   TYPE(NODE), POINTER :: C
   TYPE(dim3) :: DIM_GRID, DIM_BLOCK

   N = LIST_TAGGED%NUM_NODES ! Get the number of nodes in the tagged list

   IF (N == 0) RETURN ! No nodes, nothing to do

   IF (.NOT. ALLOCATED(NORMVECTORX_h) .OR. SIZE(NORMVECTORX_h) < N) THEN ! If the host arrays are not allocated or too small, reallocate them
       IF (ALLOCATED(NORMVECTORX_h)) DEALLOCATE(NORMVECTORX_h, NORMVECTORY_h, PHIP_OLD_h, PHIP_NBHD_h)
       ALLOCATE(NORMVECTORX_h(N), NORMVECTORY_h(N), PHIP_OLD_h(N), PHIP_NBHD_h(5,N))
   ENDIF

   ! DLL to SoA of PHIP values
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      PHIP_NBHD_h(1,I) = PHIP(C%IX-1, C%IY)   ! W
      PHIP_NBHD_h(2,I) = PHIP(C%IX+1, C%IY)   ! E
      PHIP_NBHD_h(3,I) = PHIP(C%IX,   C%IY-1) ! S
      PHIP_NBHD_h(4,I) = PHIP(C%IX,   C%IY+1) ! N
      PHIP_NBHD_h(5,I) = PHIP(C%IX,   C%IY)   ! C
      C => C%NEXT
   ENDDO

   ! Allocate device arrays if not allocated or if N has changed
   IF (CALC_NORMAL_N_d < N) THEN
      IF (ALLOCATED(NORMVECTORX_d)) DEALLOCATE(NORMVECTORX_d, NORMVECTORY_d, PHIP_OLD_d, PHIP_NBHD_d)
      ALLOCATE(NORMVECTORX_d(N), NORMVECTORY_d(N), PHIP_OLD_d(N), PHIP_NBHD_d(5,N))
      CALC_NORMAL_N_d = N
   ENDIF

   ! Copy to device arrays
   PHIP_NBHD_d(1:5,1:N) = PHIP_NBHD_h(1:5,1:N)

   ! Launch calc normal vectors kernel
   DIM_BLOCK = dim3(256, 1, 1)
   DIM_GRID = dim3(CEILING((REAL(N)) / DIM_BLOCK%x), 1, 1) ! Grid stride loop revisar
   CALL CALC_NORMAL_VECTORS_KERNEL<<<DIM_GRID, DIM_BLOCK>>>( PHIP_NBHD_d, NORMVECTORX_d,&
    NORMVECTORY_d, PHIP_OLD_d, N, ISTEP, HALFRCELLSIZE )

   ! Check for any CUDA errors, and synchronize the device to ensure all threads have completed
   CUDA_ERR = cudaDeviceSynchronize()

   ! Copy results from device to host
   NORMVECTORX_h(1:N) = NORMVECTORX_d(1:N)
   NORMVECTORY_h(1:N) = NORMVECTORY_d(1:N)
   IF (ISTEP == 1) PHIP_OLD_h(1:N) = PHIP_OLD_d(1:N)

   ! Update the linked list with the new normal vectors and PHIP_OLD values
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      C%NORMVECTORX = NORMVECTORX_h(I)
      C%NORMVECTORY = NORMVECTORY_h(I)
      IF (ISTEP == 1) C%PHIP_OLD = PHIP_OLD_h(I)
      C => C%NEXT
   ENDDO

! *****************************************************************************
END SUBROUTINE CALC_NORMAL_VECTORS_CUDA
! *****************************************************************************

! *****************************************************************************
! Kernel to calculate the normal vectors of the nodes in the tagged list
ATTRIBUTES (GLOBAL) SUBROUTINE CALC_NORMAL_VECTORS_KERNEL( PHIP_NBHD, NORMVECTORX, NORMVECTORY, PHIP_OLD, N, ISTEP, HALFRCELLSIZE)
! *****************************************************************************

   INTEGER, VALUE :: N, ISTEP
   REAL, VALUE :: HALFRCELLSIZE
   REAL, DEVICE :: PHIP_NBHD(5,N)
   REAL, DEVICE :: NORMVECTORX(N), NORMVECTORY(N), PHIP_OLD(N)

   INTEGER :: I
   REAL :: DPHIDX, DPHIDY, RMAGGRADPHI
   REAL, PARAMETER :: EPSILON = 1E-30, BIG = 3E4

   I = (blockIdx%x - 1) * blockDim%x + threadIdx%x ! Index of the current thread in GPU

   IF (I > N) RETURN ! Avoid out-of-bounds threads from doing any work

   IF (ISTEP .EQ. 1) THEN
      PHIP_OLD(I) = PHIP_NBHD(5,I)
      DPHIDY = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(4,I) - PHIP_NBHD(3,I)), BIG ), -BIG)
      DPHIDX = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(2,I) - PHIP_NBHD(1,I)), BIG ), -BIG)
   ELSE
      DPHIDX = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(2,I) - PHIP_NBHD(1,I)), BIG ), -BIG)
      DPHIDY = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(4,I) - PHIP_NBHD(3,I)), BIG ), -BIG)
   ENDIF

   RMAGGRADPHI = 1. / MAX(SQRT( DPHIDX * DPHIDX + DPHIDY * DPHIDY ), EPSILON)·

   NORMVECTORX(I) = RMAGGRADPHI * DPHIDX
   NORMVECTORY(I) = RMAGGRADPHI * DPHIDY

! *****************************************************************************
END SUBROUTINE CALC_NORMAL_VECTORS_KERNEL
! *****************************************************************************

! *****************************************************************************
! CUDA version of the 2nd order Runge-Kutta integration of PHIP, this is the wrapper
SUBROUTINE RK2_INTEGRATE_CUDA(DT, ISTEP)
! *****************************************************************************

   REAL, INTENT(IN) :: DT
   INTEGER, INTENT(IN) :: ISTEP
   INTEGER :: I, N
   TYPE(NODE), POINTER :: C
   TYPE(dim3) :: DIM_GRID, DIM_BLOCK

   N = LIST_TAGGED%NUM_NODES ! Get the number of nodes in the tagged list

   IF (N == 0) RETURN ! No nodes, nothing to do

   IF (.NOT. ALLOCATED(RK2_PHIP_OLD_h) .OR. SIZE(RK2_PHIP_OLD_h) < N) THEN ! If the host arrays are not allocated or too small, reallocate them
      IF (ALLOCATED(RK2_PHIP_OLD_h)) DEALLOCATE(RK2_PHIP_OLD_h, RK2_UX_h, RK2_UY_h, &
         RK2_DPHIDX_LIMITED_h, RK2_DPHIDY_LIMITED_h, RK2_PHIP_NOW_h, RK2_PHIP_NEW_h, RK2_WTU_SPREAD_h)
      ALLOCATE(RK2_PHIP_OLD_h(N), RK2_UX_h(N), RK2_UY_h(N), &
         RK2_DPHIDX_LIMITED_h(N), RK2_DPHIDY_LIMITED_h(N), RK2_PHIP_NOW_h(N), RK2_PHIP_NEW_h(N), RK2_WTU_SPREAD_h(N))
   ENDIF

   ! DLL to SoA
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      RK2_PHIP_OLD_h(I)       = C%PHIP_OLD
      RK2_UX_h(I)             = C%UX
      RK2_UY_h(I)             = C%UY
      RK2_DPHIDX_LIMITED_h(I) = C%DPHIDX_LIMITED
      RK2_DPHIDY_LIMITED_h(I) = C%DPHIDY_LIMITED
      RK2_WTU_SPREAD_h(I)     = C%WTU_SPREAD
      IF (ISTEP == 2) RK2_PHIP_NOW_h(I) = PHIP(C%IX, C%IY) ! ISTEP=2 needs the current on-grid value; kernel cannot read PHIP directly
      C => C%NEXT
   ENDDO

   ! Allocate device arrays if not allocated or if N has changed
   IF (RK2_N_d < N) THEN
      IF (ALLOCATED(RK2_PHIP_OLD_d)) DEALLOCATE(RK2_PHIP_OLD_d, RK2_UX_d, RK2_UY_d, &
         RK2_DPHIDX_LIMITED_d, RK2_DPHIDY_LIMITED_d, RK2_PHIP_NOW_d, RK2_PHIP_NEW_d, RK2_WTU_SPREAD_d)
      ALLOCATE(RK2_PHIP_OLD_d(N), RK2_UX_d(N), RK2_UY_d(N), &
         RK2_DPHIDX_LIMITED_d(N), RK2_DPHIDY_LIMITED_d(N), RK2_PHIP_NOW_d(N), RK2_PHIP_NEW_d(N), RK2_WTU_SPREAD_d(N))
      RK2_N_d = N
   ENDIF

   ! Copy to device arrays
   RK2_PHIP_OLD_d(1:N)       = RK2_PHIP_OLD_h(1:N)
   RK2_UX_d(1:N)             = RK2_UX_h(1:N)
   RK2_UY_d(1:N)             = RK2_UY_h(1:N)
   RK2_DPHIDX_LIMITED_d(1:N) = RK2_DPHIDX_LIMITED_h(1:N)
   RK2_DPHIDY_LIMITED_d(1:N) = RK2_DPHIDY_LIMITED_h(1:N)
   RK2_WTU_SPREAD_d(1:N)     = RK2_WTU_SPREAD_h(1:N)
   IF (ISTEP == 2) RK2_PHIP_NOW_d(1:N) = RK2_PHIP_NOW_h(1:N)

   ! Launch RK2 integration kernel
   DIM_BLOCK = dim3(256, 1, 1)
   DIM_GRID  = dim3(CEILING((REAL(N)) / DIM_BLOCK%x), 1, 1)
   CALL RK2_INTEGRATE_KERNEL<<<DIM_GRID, DIM_BLOCK>>>( RK2_PHIP_OLD_d, RK2_UX_d, RK2_UY_d, &
    RK2_DPHIDX_LIMITED_d, RK2_DPHIDY_LIMITED_d, RK2_PHIP_NOW_d, RK2_PHIP_NEW_d, RK2_WTU_SPREAD_d, N, ISTEP, DT )

   ! Check for any CUDA errors, and synchronize the device to ensure all threads have completed
   CUDA_ERR = cudaDeviceSynchronize()

   ! Copy results from device to host
   RK2_PHIP_NEW_h(1:N) = RK2_PHIP_NEW_d(1:N)

   ! Scatter the new PHIP values back onto the host grid at each node's position
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      PHIP(C%IX, C%IY) = RK2_PHIP_NEW_h(I)
      C => C%NEXT
   ENDDO

! *****************************************************************************
END SUBROUTINE RK2_INTEGRATE_CUDA
! *****************************************************************************

! *****************************************************************************
! Kernel to perform the 2nd order Runge-Kutta integration of PHIP for the nodes in the tagged list
ATTRIBUTES (GLOBAL) SUBROUTINE RK2_INTEGRATE_KERNEL( PHIP_OLD, UX, UY, DPHIDX_LIMITED, DPHIDY_LIMITED, &
                                                       PHIP_NOW, PHIP_NEW, WTU_SPREAD, N, ISTEP, DT )
! *****************************************************************************

   INTEGER, VALUE :: N, ISTEP
   REAL,    VALUE :: DT
   REAL, DEVICE :: PHIP_OLD(N), UX(N), UY(N), DPHIDX_LIMITED(N), DPHIDY_LIMITED(N)
   REAL, DEVICE :: PHIP_NOW(N), PHIP_NEW(N)
   LOGICAL, DEVICE :: WTU_SPREAD(N)

   REAL, PARAMETER :: LIMIT = 1.0 ! Same clamp as CPU RK2_INTEGRATE
   INTEGER :: I

   I = (blockIdx%x - 1) * blockDim%x + threadIdx%x ! Index of the current thread in GPU

   IF (I > N) RETURN ! Avoid out-of-bounds threads from doing any work

   IF (ISTEP .EQ. 1) THEN
      PHIP_NEW(I) = PHIP_OLD(I) - DT * (UX(I) * DPHIDX_LIMITED(I) + UY(I) * DPHIDY_LIMITED(I))
      IF ( PHIP_NEW(I) .NE. PHIP_NEW(I) ) PHIP_NEW(I) = 1.0 ! NaN check
      IF ( PHIP_NEW(I) .LT. -1 * LIMIT )  PHIP_NEW(I) = -1 * LIMIT
      IF ( PHIP_NEW(I) .GT.  LIMIT )      PHIP_NEW(I) =  LIMIT
   ELSE
      PHIP_NEW(I) = 0.5 * (PHIP_OLD(I) + (PHIP_NOW(I) - DT * (UX(I) * DPHIDX_LIMITED(I) + UY(I) * DPHIDY_LIMITED(I))))
   ENDIF

   IF (WTU_SPREAD(I)) PHIP_NEW(I) = -1.0 ! Interface Model (both RK2 stages)

! *****************************************************************************
END SUBROUTINE RK2_INTEGRATE_KERNEL
! *****************************************************************************

END MODULE ELMFIRE_GPU