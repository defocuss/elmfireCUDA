! *****************************************************************************
MODULE ELMFIRE_GPU ! Module for GPU acceleration of ELMFIRE
! *****************************************************************************

   USE CUDAFOR ! Cuda fortran
   USE ELMFIRE_VARS
   IMPLICIT NONE

   ! SoA host arrays realocated every timestep
   REAL,    ALLOCATABLE :: NORMVECTORX_h(:), NORMVECTORY_h(:), PHIP_OLD_h(:)
   REAL,    ALLOCATABLE :: PHIP_NBHD_h(:,:) ! Values of PHIP

   ! Device arrays
   REAL,    DEVICE, ALLOCATABLE :: NORMVECTORX_d(:), NORMVECTORY_d(:), PHIP_OLD_d(:)
   REAL,    DEVICE, ALLOCATABLE :: PHIP_NBHD_d(:,:)

   ! State
   INTEGER, SAVE :: N_d = 0 ! Current size of the device arrays
   INTEGER :: CUDA_ERR ! Error code for CUDA operations
    
CONTAINS

! *****************************************************************************
SUBROUTINE CALC_NORMAL_VECTORS_CUDA(ISTEP, HALFRCELLSIZE) ! CUDA version of the normal vector calculation, this is the wraper
! *****************************************************************************
   INTEGER, INTENT(IN) :: ISTEP
   REAL, INTENT(IN) :: HALFRCELLSIZE
   INTEGER :: I, N
   TYPE(NODE), POINTER :: C
   TYPE(dim3) :: DIM_GRID, DIM_BLOCK

   N = LIST_TAGGED%NUM_NODES ! Get the number of nodes in the tagged list

   IF (N == 0) RETURN ! No nodes, nothing to do

   IF (.NOT. ALLOCATED(NORMVECTORX_h) .OR. SIZE(NORMVECTORX_h) < N) THEN ! If the host arrays are not allocated or too small, reallocate them
       IF (ALLOCATED(NORMVECTORX_h)) DEALLOCATE(NORMVECTORX_h, NORMVECTORY_h, PHIP_OLD_h, PHIP_NBHD_h)
       ALLOCATE(NORMVECTORX_h(N), NORMVECTORY_h(N), PHIP_OLD_h(N), PHIP_NBHD_h(5,N))
   ENDIF

   ! DLL to SoA of PHIP values
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      PHIP_NBHD_h(1,I) = PHIP(C%IX-1, C%IY)   ! W
      PHIP_NBHD_h(2,I) = PHIP(C%IX+1, C%IY)   ! E
      PHIP_NBHD_h(3,I) = PHIP(C%IX,   C%IY-1) ! S
      PHIP_NBHD_h(4,I) = PHIP(C%IX,   C%IY+1) ! N
      PHIP_NBHD_h(5,I) = PHIP(C%IX,   C%IY)   ! C
      C => C%NEXT
   ENDDO

   ! Allocate device arrays if not allocated or if N has changed
   IF (N_d < N) THEN
      IF (ALLOCATED(NORMVECTORX_d)) DEALLOCATE(NORMVECTORX_d, NORMVECTORY_d, PHIP_OLD_d, PHIP_NBHD_d)
      ALLOCATE(NORMVECTORX_d(N), NORMVECTORY_d(N), PHIP_OLD_d(N), PHIP_NBHD_d(5,N))
      N_d = N
   ENDIF

   ! Copy to device arrays
   PHIP_NBHD_d(1:5,1:N) = PHIP_NBHD_h(1:5,1:N)

   ! Launch calc normal vectors kernel
   DIM_BLOCK = dim3(256, 1, 1)
   DIM_GRID = dim3(CEILING((REAL(N)) / DIM_BLOCK%x), 1, 1) ! Grid stride loop revisar
   CALL CALC_NORMAL_VECTORS_KERNEL<<<DIM_GRID, DIM_BLOCK>>>( PHIP_NBHD_d, NORMVECTORX_d,&
    NORMVECTORY_d, PHIP_OLD_d, N, ISTEP, HALFRCELLSIZE )

   ! Check for any CUDA errors, and synchronize the device to ensure all threads have completed
   CUDA_ERR = cudaDeviceSynchronize()

   ! Copy results from device to host
   NORMVECTORX_h(1:N) = NORMVECTORX_d(1:N)
   NORMVECTORY_h(1:N) = NORMVECTORY_d(1:N)
   IF (ISTEP == 1) PHIP_OLD_h(1:N) = PHIP_OLD_d(1:N)

   ! Update the linked list with the new normal vectors and PHIP_OLD values
   C => LIST_TAGGED%HEAD
   DO I = 1, N
      C%NORMVECTORX = NORMVECTORX_h(I)
      C%NORMVECTORY = NORMVECTORY_h(I)
      IF (ISTEP == 1) C%PHIP_OLD = PHIP_OLD_h(I)
      C => C%NEXT
   ENDDO

! *****************************************************************************
END SUBROUTINE CALC_NORMAL_VECTORS_CUDA
! *****************************************************************************

! *****************************************************************************
ATTRIBUTES (GLOBAL) SUBROUTINE CALC_NORMAL_VECTORS_KERNEL( PHIP_NBHD, NORMVECTORX, NORMVECTORY, PHIP_OLD, N, ISTEP, HALFRCELLSIZE) ! Kernel to calculate the normal vectors of the nodes in the tagged list
! *****************************************************************************

   INTEGER, VALUE :: N, ISTEP
   REAL, VALUE :: HALFRCELLSIZE
   REAL, DEVICE :: PHIP_NBHD(5,N)
   REAL, DEVICE :: NORMVECTORX(N), NORMVECTORY(N), PHIP_OLD(N)

   INTEGER :: I
   REAL :: DPHIDX, DPHIDY, RMAGGRADPHI
   REAL, PARAMETER :: EPSILON = 1E-30, BIG = 3E4

   I = (blockIdx%x - 1) * blockDim%x + threadIdx%x ! Index of the current thread in GPU

   IF (I > N) RETURN ! Avoid out-of-bounds threads from doing any work

   IF (ISTEP .EQ. 1) THEN
      PHIP_OLD(I) = PHIP_NBHD(5,I)
      DPHIDY = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(4,I) - PHIP_NBHD(3,I)), BIG ), -BIG)
      DPHIDX = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(2,I) - PHIP_NBHD(1,I)), BIG ), -BIG)
   ELSE
      DPHIDX = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(2,I) - PHIP_NBHD(1,I)), BIG ), -BIG)
      DPHIDY = MAX(MIN( HALFRCELLSIZE * (PHIP_NBHD(4,I) - PHIP_NBHD(3,I)), BIG ), -BIG)
   ENDIF

   RMAGGRADPHI = 1. / MAX(SQRT( DPHIDX * DPHIDX + DPHIDY * DPHIDY ), EPSILON)·

   NORMVECTORX(I) = RMAGGRADPHI * DPHIDX
   NORMVECTORY(I) = RMAGGRADPHI * DPHIDY

! *****************************************************************************
END SUBROUTINE CALC_NORMAL_VECTORS_KERNEL
! *****************************************************************************

END MODULE ELMFIRE_GPU